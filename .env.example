# Front en Vercel y en tu máquina.
# Local: déjalo así y corre el API en el puerto 8000.
# Vercel → Project → Settings → Environment Variables:
#   VITE_API_URL = https://TU-SERVICIO.onrender.com
# Sin barra al final. Tiene que ser la URL pública del backend en Render.
VITE_API_URL=http://localhost:8000

# El MISMO valor que GOOGLE_CLIENT_ID del backend.
# Google Cloud → Credenciales → ID de cliente de OAuth (aplicación web).
# En Vercel se llama igual: VITE_GOOGLE_CLIENT_ID.
# Vite la mete en el build: si la cambias, reinicia `npm run dev`
# o vuelve a desplegar en Vercel.
# Orígenes autorizados en Google: http://localhost:5173, http://127.0.0.1:5173
# y la URL de Vercel. El Client secret no va aquí.
VITE_GOOGLE_CLIENT_ID=
